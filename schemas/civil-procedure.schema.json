{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MiguelFR84/spanish-legal-procedure-automation/schemas/civil-procedure.schema.json",
  "title": "Spanish Civil Procedure",
  "description": "Reusable structure for Spanish civil procedure workflows, timelines and educational automation.",
  "type": "object",
  "required": ["id", "jurisdiction", "procedureName", "legalBasis", "phases"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]+$"
    },
    "jurisdiction": {
      "type": "string",
      "const": "Spain"
    },
    "procedureName": {
      "type": "string",
      "minLength": 3
    },
    "legalBasis": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "disclaimer": {
      "type": "string"
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/phase"
      }
    }
  },
  "$defs": {
    "phase": {
      "type": "object",
      "required": ["id", "title", "order", "steps"],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "objective": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      }
    },
    "step": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "deadline": {
          "type": "string"
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      }
    }
  }
}
